# =============================================================================
# ENVIRONMENT SWITCH
# =============================================================================
# Set to "PROD"  -> Production Server: Initial auth via Okta SSO, Step-up via LDAPS
# Set to "DEV"   -> Dev Server: Initial & Step-up auth via LDAPS (records actual user)
# Set to "LOCAL" -> Local Machine: Developer sandbox (uses DEV_DEFAULT_USER)
ENVIRONMENT="DEV"
APP_ENV="DEV"
# Set to true to run locally with self-contained demo providers (no live ISE, Catalyst Center, Meraki, CUCM, UCCX, CUC, or AD connections)
DEMO_MODE=false

# --- Primary Authentication Mode Selector ---
# PROD: OKTA (OIDC Bearer tokens)
# DEV:  LDAPS (Active Directory authentication recording real user)
AUTH_METHOD=LDAPS
# Keep ENVIRONMENT and APP_ENV aligned:
# LOCAL: no primary login; LDAP step-up for privileged tasks
# DEV: LDAP primary login and LDAP step-up for privileged tasks
# PROD: Okta primary login and LDAP step-up for privileged tasks
# =============================================================================

# --- Portal & Network Boundaries ---
CORS_ORIGINS=http://localhost:8000,https://netdashboard.corp.internal
VPN_SUBNET_PREFIXES=10.200.10.,10.200.11.
DEFAULT_EMAIL_DOMAIN=corp.internal

# Default user identity for LOCAL sandbox mode
DEV_DEFAULT_USER="dev-engineer@corp.internal"

# Application Settings
APP_NAME="NetDashboard"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY"

# Okta OIDC Settings (Used in PROD for initial authentication)
OKTA_ISSUER="https://your-org.okta.com/oauth2/default"
OKTA_CLIENT_ID="Client_ID"
OKTA_AUDIENCE="Audience_ID"

# --- Okta Role Mapping Groups (PROD Initial Auth) ---
OKTA_GROUP_NETWORK_ADMIN="ADMIN_GROUP_MAPPING"
OKTA_GROUP_TECH_SERVICES="TECH_GROUP_MAPPING"
OKTA_GROUP_HELPDESK="HELPDESK_GROUP_MAPPING"

# Active Directory / LDAPS (DEV Initial Auth & ALL Step-Up Authentications)
LDAP_SERVER_URI=ldaps://dc01.corp.internal:3269
LDAP_DOMAIN=corp.internal
LDAP_SEARCH_BASE=DC=corp,DC=internal
AD_NETBIOS_DOMAIN=
LDAP_VERIFY_SSL=true

# Active Directory Service Account (For querying group memberships in DEV & Step-Up)
LDAP_BIND_USER="svc_netdashboard"
LDAP_BIND_PASSWORD="YourSecurePassword"

# Active Directory Role Mapping Groups
AD_GROUP_NETWORK_ADMIN="LDAP_ADMIN_GROUP_MAPPING"
AD_GROUP_TECH_SERVICES="LDAP_TECH_GROUP_MAPPING"
AD_GROUP_HELPDESK="LDAP_HELPDESK_GROUP_MAPPING"
SCCM_REIMAGING_GROUP="AD_REIMAGING_GROUP"

# Cisco Identity Services Engine (ISE 3.4)
ISE_PAN_IP="10.100.10.15"
ISE_REST_USERNAME="ise_api_admin"
ISE_REST_PASSWORD="YourSecurePassword"
ISE_API_VERSION=3.3_patch_1
ISE_VERIFY_SSL=false

# RADIUS Configuration
RADIUS_SHARED_SECRET="RADIUSSharedSecret"

# ISE NDG Variables
ISE_DEFAULT_LOCATION_NDG=Location#All Locations#Corporate
ISE_NDG_TARGET_VLAN_ID=21
ISE_NDG_REPORT_DIR=reports
ISE_NDG_UPDATE_RADIUS_SECRET=false
ISE_NDG_REQUEST_TIMEOUT_SECONDS=30
ISE_NDG_ERS_PAGE_SIZE=100

# Microsoft SCCM / ConfigMgr (Workstation Asset Removal for Re-imaging)
SCCM_SITE_SERVER=SCCM01.corp.internal
SCCM_SITE_CODE=HQ1
SCCM_LOG_PATH=\\SCCM01.corp.internal\Asset_Removal_Logs$\Asset_Removal_Logs.csv
SCCM_TIMEOUT_SECONDS=45

# Diagnostics & ZTP DHCP
IPERF_SERVERS=
TEAP_XML_PROFILES=
TEAP_CA_FILTER=
ZTP_DHCP_PRIMARY_SERVER=dhcp01.corp.internal
ZTP_DHCP_PARTNER_SERVER=dhcp02.corp.internal
ZTP_DHCP_FAILOVER_RELATIONSHIP=
ZTP_DHCP_DNS_SERVERS=
ZTP_DHCP_DNS_DOMAIN=
ZTP_DHCP_LEASE_DAYS=1

# Cisco Catalyst Center (DNA Center)
DNAC_IP="10.100.10.20"
DNAC_USER="dnac_api_user"
DNAC_PASS="YourDnacPassword"

# Cisco Meraki Dashboard
MERAKI_API_KEY="0123456789abcdef0123456789abcdef01234567"
MERAKI_ORG_ID="1234567"
MERAKI_LOOKBACK_DAYS=31
MERAKI_CACHE_TTL_SECONDS=14400
MERAKI_MAX_RETRIES=1
MERAKI_REQUEST_TIMEOUT_SECONDS=10
MERAKI_ENRICH_DEVICE_NAMES=false

# Logging
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/app.log"

# Task Queue / State Store Broker
VALKEY_URL=redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Cisco FMC Configuration
FMC_HOST=fmc.example.internal
FMC_USER="fmc_username"
FMC_PASS="YourFMCPassword"

# iPSK Manager Configuration
IPSK_DB_HOST="10.200.20.10"
IPSK_DB_PORT=3306
IPSK_DB_USER="ipsk_db_user"
IPSK_DB_PASS="YourIpskDbPassword"
IPSK_DB_NAME=ipsk

# =============================================================================
# PRIMARY CLUSTER (CUCM 12.5 SU1 / UCCX 12.5 SU3 / CUC 14 SU4)
# =============================================================================
PRIMARY_CUCM_AXL_HOST="10.200.30.10"
PRIMARY_CUCM_AXL_USER="axl_admin"
PRIMARY_CUCM_AXL_PASS="YourAxlPassword"
PRIMARY_CUCM_AXL_VERSION="12.5"
PRIMARY_CUCM_AXL_VERIFY_SSL=false
PRIMARY_CUCM_AXL_TIMEOUT_SECONDS=30

PRIMARY_UCCX_HOST="10.200.30.11"
PRIMARY_UCCX_USER="uccx_admin"
PRIMARY_UCCX_PASS="YourUccxPassword"
PRIMARY_UCCX_VERIFY_SSL=false
PRIMARY_UCCX_TIMEOUT_SECONDS=30

PRIMARY_CUC_HOST="10.200.30.12"
PRIMARY_CUC_USER="cuc_admin"
PRIMARY_CUC_PASS="YourCucPassword"
PRIMARY_CUC_VERIFY_SSL=false
PRIMARY_CUC_TIMEOUT_SECONDS=30
PRIMARY_CUC_PAGE_SIZE=100

# =============================================================================
# SECONDARY CLUSTER (CUCM 11.5.1 / UCCX 12.0.1 / CUC 11.5.1)
# =============================================================================
HAWAII_CUCM_AXL_HOST="10.200.40.10"
HAWAII_CUCM_AXL_USER="sec_axl_admin"
HAWAII_CUCM_AXL_PASS="YourSecondaryAxlPassword"
HAWAII_CUCM_AXL_VERSION="11.5"
HAWAII_CUCM_AXL_VERIFY_SSL=false
HAWAII_CUCM_AXL_TIMEOUT_SECONDS=45

HAWAII_UCCX_HOST="10.200.40.11"
HAWAII_UCCX_USER="sec_uccx_admin"
HAWAII_UCCX_PASS="YourSecondaryUccxPassword"
HAWAII_UCCX_VERIFY_SSL=false
HAWAII_UCCX_TIMEOUT_SECONDS=45

HAWAII_CUC_HOST="10.200.40.12"
HAWAII_CUC_USER="sec_cuc_admin"
HAWAII_CUC_PASS="YourSecondaryCucPassword"
HAWAII_CUC_VERIFY_SSL=false
HAWAII_CUC_TIMEOUT_SECONDS=45

# =============================================================================
# Cisco Webex Control Hub API Credentials
# =============================================================================
# NOTE: Webex Personal Access Tokens expire after 12 hours. Engineers can paste
# their active 12-hour token directly in the Webex Migration web UI without
# modifying this file. Alternatively, a persistent Service App Bearer Token
# can be set here.
# Required Scopes: spark-admin:people_write, spark-admin:people_read,
#                  spark-admin:telephony_config_write, spark-admin:telephony_config_read
WEBEX_ACCESS_TOKEN=""
WEBEX_VERIFY_SSL=true
WEBEX_ORG_ID="YourWebexOrgId"
WEBEX_DEFAULT_LOCATION_ID="YourDefaultLocationId"

# Optional Webex Calling License ID (extracted via Control Hub / Licenses API)
WEBEX_CALLING_LICENSE_ID="YourWebexCallingLicenseId"
VOICE_SUPERNET_CIDR=""

# =============================================================================
# Cisco UCCX 12.5 SU3 REST API Configuration
# =============================================================================
UCCX_HOST="10.200.30.11"
UCCX_USER="uccx_api_user"
UCCX_PASS="YourUccxPassword"
UCCX_VERIFY_SSL=false
UCCX_TIMEOUT_SECONDS=30

# =============================================================================
# Cisco Unity Connection (CUC 14 SU4) CUPI API Configuration
# =============================================================================
CUC_HOST="10.200.30.12"
CUC_USER="cuc_api_user"
CUC_PASS="YourCucPassword"
CUC_VERIFY_SSL=false
CUC_TIMEOUT_SECONDS=30
CUC_PAGE_SIZE=100
CUC_EXPORT_DIR=exports/voicemail

# =============================================================================
# RedSky E.911 Provider API Key
# =============================================================================
REDSKY_URL="https://api.wxc.e911cloud.com"
REDSKY_API="YourRedskyApiKey"